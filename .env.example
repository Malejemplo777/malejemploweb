# Copy to .env and fill in as each piece becomes available.
# See GATE24_Web_Brief_v2.md for what each of these is for.

# Google Analytics measurement ID (section 8). Cookie banner only loads GA
# once a visitor accepts, and only if this is set.
PUBLIC_GA_MEASUREMENT_ID=

# Formspree (or equivalent) form endpoints (section 7/12).
PUBLIC_NEWSLETTER_FORM_ACTION=
PUBLIC_CONTACT_FORM_ACTION=

# Gumroad product page URL (section 3/12).
PUBLIC_GUMROAD_URL=
