---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.tsx';
import { langFromUrl, ui } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  theme?: string;
  /** Path of the same page in the other language, if it exists. Drives the
   *  language switcher and the hreflang tags. */
  alternatePath?: string;
}

const { title, description, ogImage = '/favicon.png', theme, alternatePath } = Astro.props;
const lang = langFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Malejemplo' ? title : `${title} — Malejemplo`;

const enPath = lang === 'en' ? Astro.url.pathname : alternatePath;
const esPath = lang === 'es' ? Astro.url.pathname : alternatePath;
const abs = (path: string) => new URL(path, Astro.site);
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {enPath && <link rel="alternate" hreflang="en" href={abs(enPath)} />}
    {esPath && <link rel="alternate" hreflang="es" href={abs(esPath)} />}
    {enPath && <link rel="alternate" hreflang="x-default" href={abs(enPath)} />}
    <meta name="google-site-verification" content="HlmVKnrKKMyswgqsiV8USDtfYKr7VlieDXBVJCLOFb0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {alternatePath && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{ui[lang].skip}</a>
    <Header lang={lang} alternatePath={alternatePath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent client:load lang={lang} />
  </body>
</html>
