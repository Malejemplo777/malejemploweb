---
import { Image } from 'astro:assets';
import { shots } from '../data/shots';
import { pagePath, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const shot = shots['m07-cinema35'];
const copy = {
  en: {
    title: 'Film tools, made by one person who edits too.',
    lede: 'Finishing tools for DaVinci Resolve, starting with GATE.24: crop bars, lens vignette and film grain in one click.',
    primary: 'See GATE.24',
    secondary: 'Read the guides',
    caption: 'Shot and graded with GATE.24 — Cinema 35',
  },
  es: {
    title: 'Herramientas de cine hechas por alguien que también edita.',
    lede: 'Herramientas de acabado para DaVinci Resolve, empezando por GATE.24: barras de recorte, viñeta de óptica y grano de película en un clic.',
    primary: 'Ver GATE.24',
    secondary: 'Leer las guías',
    caption: 'Rodado y etalonado con GATE.24 — Cinema 35',
  },
}[lang];
---

<section class="home-hero" aria-labelledby="home-title">
  <Image
    class="frame"
    src={shot.src}
    alt={shot.alt[lang]}
    widths={[900, 1400, 2000, 2400]}
    sizes="(max-width: 640px) 2000px, 100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="bar bar-top" aria-hidden="true"></div>
  <div class="bar bar-bottom" aria-hidden="true"></div>
  <div class="shade" aria-hidden="true"></div>

  <div class="container inner">
    <div class="copy">
      <h1 id="home-title">{copy.title}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="actions">
        <a class="btn btn-primary" href={pagePath('gate24', lang)}>{copy.primary}</a>
        <a class="btn btn-ghost" href={pagePath('guides', lang)}>{copy.secondary}</a>
      </div>
    </div>
  </div>
  <p class="cap">{copy.caption}</p>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - 4rem);
    padding-top: var(--space-5);
    padding-bottom: calc(var(--bar) + var(--space-4));
    overflow: hidden;
    background: #000;
    --bar: clamp(2.5rem, 9vh, 6rem);
  }

  .frame {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.82) 0%, rgb(0 0 0 / 0.35) 42%, transparent 70%),
      radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / 0.45) 100%);
  }

  /* The crop bars close in on load: the same gesture GATE.24 does to a shot. */
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    z-index: -2;
    height: var(--bar);
    background: #000;
    animation: bars 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
  }

  .bar-top {
    top: 0;
    transform-origin: top;
  }

  .bar-bottom {
    bottom: 0;
    transform-origin: bottom;
  }

  .inner {
    position: relative;
  }

  /* The subject of the frame walks on the left, so on wide screens the copy
     takes the open sea on the right. */
  @media (min-width: 60rem) {
    .inner {
      display: flex;
      justify-content: flex-end;
    }

    .copy {
      width: min(34rem, 52%);
    }
  }

  h1 {
    max-width: 14ch;
    margin-bottom: var(--space-2);
    font-size: clamp(2.5rem, 4.5vw + 0.5rem, 4.75rem);
    text-shadow: 0 2px 40px rgb(0 0 0 / 0.5);
  }

  .lede {
    max-width: 44ch;
    margin-bottom: var(--space-3);
    font-size: clamp(1rem, 0.6vw + 0.9rem, 1.2rem);
    color: var(--color-fg);
    opacity: 0.85;
  }

  .actions :global(.btn-ghost) {
    background: rgb(0 0 0 / 0.3);
    border-color: rgb(245 245 243 / 0.55);
    backdrop-filter: blur(6px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cap {
    position: absolute;
    right: var(--space-3);
    bottom: calc(var(--bar) + 0.75rem);
    margin: 0;
    max-width: none;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-fg);
    opacity: 0.7;
    text-align: right;
  }

  @keyframes settle {
    from {
      transform: scale(1.08);
      filter: brightness(0.6);
    }
    to {
      transform: scale(1);
      filter: brightness(1);
    }
  }

  @keyframes bars {
    from {
      transform: scaleY(5);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (max-width: 640px) {
    .frame {
      object-position: 19% 50%;
    }

    .cap {
      display: none;
    }

    .actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .bar {
      animation: none;
    }
  }
</style>
