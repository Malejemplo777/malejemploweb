---
import { Image } from 'astro:assets';
import { shots, type ShotKey } from '../data/shots';
import type { Lang } from '../i18n';

interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
  cover?: ShotKey;
  lang?: Lang;
}

const { title, text, href, label, cover = 'm07-cinema35', lang = 'en' } = Astro.props;
const shot = shots[cover];
---

<section class="band">
  <Image src={shot.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" class="bg" />
  <div class="container inner">
    <h2>{title}</h2>
    <p>{text}</p>
    <p><a class="btn btn-primary" href={href}>{label}</a></p>
  </div>
  <p class="cap">{shot.caption[lang]}</p>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-6);
    background: #000;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.4) 60%, transparent 100%);
  }

  .inner {
    max-width: var(--content-width);
  }

  h2 {
    max-width: 18ch;
  }

  p {
    color: var(--color-fg);
    max-width: 40ch;
  }

  .cap {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-2);
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .cap {
      display: none;
    }
  }
</style>
