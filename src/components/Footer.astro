---
import NewsletterForm from './NewsletterForm.astro';
import { social } from '../data/social';
import { pagePath, ui, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang].footer;

const socialLinks = [
  { key: 'youtube', label: 'YouTube', href: social.youtube },
  { key: 'instagram', label: 'Instagram', href: social.instagram },
  { key: 'tiktok', label: 'TikTok', href: social.tiktok },
  { key: 'x', label: 'X', href: social.x },
].filter((s) => s.href);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="eyebrow">Malejemplo</p>
      <p class="tagline">{t.tagline}</p>
      {socialLinks.length > 0 && (
        <ul class="social">
          {socialLinks.map((s) => (
            <li><a href={s.href!} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <p class="eyebrow">{t.stay}</p>
      <NewsletterForm lang={lang} />
    </div>

    <div>
      <p class="eyebrow">{t.legal}</p>
      <ul class="legal-links">
        <li><a href={pagePath('about', lang, '#contact')}>{t.contact}</a></li>
        <li><a href={pagePath('privacy', lang)}>{t.privacy}</a></li>
        <li><a href={pagePath('cookies', lang)}>{t.cookies}</a></li>
        <li><button type="button" id="cookie-settings-btn" class="link-button">{t.cookieSettings}</button></li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>&copy; {year} Malejemplo. {t.copyright}</p>
  </div>
</footer>

<script>
  document.getElementById('cookie-settings-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cookie-settings'));
  });
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5) var(--space-3);
    margin-top: var(--space-6);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .tagline {
    font-size: 0.9rem;
  }

  .social,
  .legal-links {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social a,
  .legal-links a {
    text-decoration: none;
    color: var(--color-fg-muted);
    font-size: 0.85rem;
  }

  .social a:hover,
  .legal-links a:hover {
    color: var(--color-fg);
  }

  .link-button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--color-fg-muted);
    font-size: 0.85rem;
  }

  .link-button:hover {
    color: var(--color-fg);
  }

  .bottom {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .bottom p {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    max-width: none;
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
