---
import { CONTACT_FORM_ACTION } from '../data/social';
import { ui, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang].contact;

const isConfigured = CONTACT_FORM_ACTION.length > 0;
---

<form
  class="contact-form"
  data-ajax-form
  action={isConfigured ? CONTACT_FORM_ACTION : undefined}
  method="POST"
  data-msg-sending={t.sending}
  data-msg-success={t.success}
  data-msg-error={t.error}
>
  <div class="field">
    <label for="contact-email">{t.email}</label>
    <input id="contact-email" name="email" type="email" required disabled={!isConfigured} />
  </div>
  <div class="field">
    <label for="contact-message">{t.message}</label>
    <textarea id="contact-message" name="message" rows="4" required disabled={!isConfigured}></textarea>
  </div>
  <button type="submit" class="btn btn-primary" disabled={!isConfigured}>{t.send}</button>
  <p class="status" data-status role="status" hidden></p>
  {!isConfigured && import.meta.env.DEV && (
    <p class="hint">
      Form not wired up yet -- set <code>PUBLIC_CONTACT_FORM_ACTION</code> in <code>.env</code>.
    </p>
  )}
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 28rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  input,
  textarea {
    padding: 0.7rem 0.9rem;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    font-family: var(--font-body);
    font-size: 0.9rem;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  button {
    align-self: flex-start;
  }

  button:disabled,
  input:disabled,
  textarea:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hint {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    max-width: none;
  }

  .hint code {
    color: var(--color-fg);
  }

  .status {
    font-size: 0.85rem;
    max-width: none;
    margin: 0;
  }

  .status[data-state='success'] {
    color: var(--color-fg);
  }

  .status[data-state='error'] {
    color: #e08a8a;
  }
</style>
