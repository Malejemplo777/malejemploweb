---
// Minimalist film-strip perforations, per the brand identity: "4 marcas por
// lado, no una fila completa/repetitiva" (03_DISEÑO_UI_BRANDING.md).
interface Props {
  side?: 'left' | 'right' | 'both';
  class?: string;
}

const { side = 'both', class: className = '' } = Astro.props;
---

{(side === 'left' || side === 'both') && (
  <div class:list={['perforations', 'perforations-left', className]} aria-hidden="true">
    {Array.from({ length: 4 }).map(() => <span></span>)}
  </div>
)}
{(side === 'right' || side === 'both') && (
  <div class:list={['perforations', 'perforations-right', className]} aria-hidden="true">
    {Array.from({ length: 4 }).map(() => <span></span>)}
  </div>
)}

<style>
  .perforations {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    width: 2rem;
    pointer-events: none;
  }

  .perforations-left {
    left: 0;
  }

  .perforations-right {
    right: 0;
  }

  .perforations span {
    display: block;
    width: 0.6rem;
    height: 0.4rem;
    background: var(--color-fg-muted);
    opacity: 0.35;
    border-radius: 1px;
  }

  @media (max-width: 640px) {
    .perforations {
      display: none;
    }
  }
</style>
