---
// Recreation of the real AUREOLE.650 panel inside DaVinci Resolve, built with
// real HTML controls instead of screenshots (crisp at any size, sliders
// genuinely drag) -- same technique as GATE.24's ResolvePanel.astro. Labels,
// ranges, defaults and hints sourced from CLE/src/CLEPlugin.cpp
// (describeInContext), not invented. Display ranges (setDisplayRange) are
// used for slider min/max, matching what the panel actually shows in Resolve.
type Row =
  | { type: 'select'; label: string; value: string; options: string[]; hint: string }
  | { type: 'slider'; label: string; value: number; min: number; max: number; step: number; digits: number; hint: string }
  | { type: 'button'; label: string; hint: string };

const sections: { title: string; open: boolean; rows: Row[] }[] = [
  {
    title: 'Preview',
    open: true,
    rows: [
      {
        type: 'select',
        label: 'Preview',
        value: 'Final Result',
        options: ['Final Result', 'Halation Mask (B/W)', 'Affected Zone (B/W)', 'Glow Mask (B/W)'],
        hint: "Instead of the result, shows what's actually happening. 'Halation Mask' = which lights count as the edge-ring source. 'Glow Mask' = which lights count as the glow source. 'Affected Zone' = where the added light actually lands once composited, including the neighboring shadow it tints. All three run on GPU and feel fluid while dragging sliders.",
      },
    ],
  },
  {
    title: 'General Glow',
    open: true,
    rows: [
      {
        type: 'slider', label: 'Glow Threshold %', value: 45.0, min: 0, max: 100, step: 0.1, digits: 2,
        hint: "Which lights create the soft glow. Raise it to keep the halo pinned to strong lights only (the sun, a streetlamp); too low and a whole bright sky counts as a source and veils over. Independent of Edge Threshold. Same 0-100 scale as Resolve's waveform.",
      },
      {
        type: 'slider', label: 'Glow Intensity', value: 0.0, min: 0, max: 1, step: 0.01, digits: 2,
        hint: "Strength of the soft glow around lights. At 1.0 its brightest point matches the source's own brightness. 0 = off (and the plugin runs faster).",
      },
      {
        type: 'select', label: 'General Glow Size', value: 'M', options: ['S', 'M', 'L', 'XL'],
        hint: 'Width and softness of the diffuse glow. M = the original behavior. L/XL push it closer to a real film halo: wider, with a longer, more gradual tail, and less pure red (warmer/whiter). Only matters if Glow Intensity > 0.',
      },
    ],
  },
  {
    title: 'Edge Halation',
    open: true,
    rows: [
      {
        type: 'slider', label: 'Edge Threshold %', value: 25.0, min: 0, max: 100, step: 0.1, digits: 2,
        hint: "Which lights count as a source for the red edge ring. Low (10-25): the edge also shows up against dimmer skies and reflections (water, hazy sky). High (35+): only against very strong lights. Same 0-100 scale as Resolve's waveform.",
      },
      {
        type: 'slider', label: 'Edge Halation %', value: 50.0, min: 0, max: 200, step: 0.5, digits: 1,
        hint: "Adds a contour ring along any strong edge, even when the bright side isn't actually blown out (a mountain silhouette against the sky, not just hard highlights). Unlike raising the threshold, this does NOT tint large flat areas like a whole sky -- just their edge. 0 = off. 50% is calibrated to match the reference node with Size M.",
      },
      {
        type: 'select', label: 'Edge Halation Size', value: 'M', options: ['S', 'M', 'L', 'XL'],
        hint: 'Width of the Edge Halation ring (S=5px, M=9.5px, L=14px, XL=22px at 4K; scales with resolution). Each step is about 1.5x the last. Only matters if Edge Halation % > 0.',
      },
      {
        type: 'slider', label: 'Edge Detail %', value: 50, min: 0, max: 100, step: 1, digits: 0,
        hint: '0 = only the big silhouettes; 50 = starting point; 100 = double the detail. Barely visible on clean silhouettes; shows up in foliage and water.',
      },
    ],
  },
  {
    title: 'Advanced',
    open: false,
    rows: [
      {
        type: 'slider', label: 'Halation Hue', value: 0.0, min: -60, max: 60, step: 0.5, digits: 1,
        hint: 'Rotates the hue of the Edge Halation color -- 0 = the Standard color, untouched. Negative toward red/magenta, positive toward orange/yellow.',
      },
      {
        type: 'slider', label: 'Halation Saturation', value: 100.0, min: 0, max: 150, step: 0.5, digits: 1,
        hint: '100% = the Standard color, untouched. 0% = gray (brightness only, no tint). The base color is already fairly saturated, so going far above 100% has little extra room; going down has full room down to gray.',
      },
      {
        type: 'button', label: 'Save as Default',
        hint: 'Saves the current values as the starting point for every new node, from the next time you open Resolve. Existing nodes and saved projects don’t change.',
      },
      {
        type: 'button', label: 'Restore Factory Defaults',
        hint: "Clears your saved defaults: new nodes go back to factory values, from the next time you open Resolve.",
      },
    ],
  },
];

const totalRows = sections.reduce((sum, s) => sum + s.rows.length, 0);

const panelHotspotCss = Array.from({ length: totalRows }, (_, i) => `
  .dv-section:has(.r${i}:hover) .dv-caption-default,
  .dv-section:has(.r${i}:focus-visible) .dv-caption-default { opacity: 0; }
  .dv-section:has(.r${i}:hover) .c${i},
  .dv-section:has(.r${i}:focus-visible) .c${i} { opacity: 1; }
`).join('\n');

let rowCounter = 0;
---

<div class="resolve-panel">
  {sections.map((section, si) => (
    <details class="dv-section" open={section.open}>
      <summary>
        <span class="dv-chevron" aria-hidden="true">&rsaquo;</span>
        {section.title}
      </summary>
      <div class="dv-body">
        <div class="dv-rows">
          {section.rows.map((row) => {
            const idx = rowCounter++;
            return (
              <div class={`dv-row r${idx}`} tabindex="0">
                <span class="dv-label">{row.type === 'button' ? '' : row.label}</span>
                <span class="dv-control">
                  {row.type === 'select' && (
                    <span class="dv-select">
                      <select aria-label={row.label}>
                        {row.options.map((opt) => <option selected={opt === row.value}>{opt}</option>)}
                      </select>
                      <span class="dv-caret" aria-hidden="true">&#9662;</span>
                    </span>
                  )}
                  {row.type === 'slider' && (
                    <span class="dv-slider">
                      <input type="range" min={row.min} max={row.max} step={row.step} value={row.value} aria-label={row.label} />
                      <input class="dv-value" type="text" readonly value={row.value.toFixed(row.digits)} tabindex="-1" />
                    </span>
                  )}
                  {row.type === 'button' && (
                    <button type="button" class="dv-button">{row.label}</button>
                  )}
                </span>
                {row.type === 'slider' && (
                  <>
                    <span class="dv-diamond" aria-hidden="true">&#9670;</span>
                    <span class="dv-reset" aria-hidden="true">&#8635;</span>
                  </>
                )}
              </div>
            );
          })}
        </div>
        <div class="dv-caption-slot">
          <p class="dv-caption-default">Hover a control to see what it does.</p>
          {section.rows.map((row, ri) => {
            const idx = rowCounter - section.rows.length + ri;
            return <p class={`dv-caption c${idx}`}><strong>{row.label}</strong> — {row.hint}</p>;
          })}
        </div>
      </div>
    </details>
  ))}
</div>

<style set:html={panelHotspotCss}></style>

<style>
  .resolve-panel {
    border-top: 1px solid var(--color-border);
    font-family: var(--font-body);
  }

  .dv-section {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-fg);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .dv-chevron {
    display: inline-block;
    font-size: 1.3rem;
    color: var(--color-fg-muted);
    transition: transform 0.15s ease;
  }

  details[open] .dv-chevron {
    transform: rotate(90deg);
  }

  .dv-body {
    display: grid;
    grid-template-columns: minmax(0, 22rem) 1fr;
    gap: var(--space-3);
    align-items: start;
    padding-bottom: var(--space-4);
  }

  .dv-rows {
    background: #1c1c1c;
    border: 1px solid #333;
    padding: 0.5rem 0.75rem;
  }

  .dv-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr 1rem 1rem;
    align-items: center;
    gap: 0.5rem;
    height: 1.7rem;
    outline: none;
  }

  .dv-row:hover,
  .dv-row:focus-visible {
    background: rgba(245, 243, 239, 0.06);
  }

  .dv-label {
    font-size: 0.72rem;
    color: #b0b0b0;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dv-control {
    min-width: 0;
  }

  .dv-diamond,
  .dv-reset {
    font-size: 0.6rem;
    color: #666;
    text-align: center;
  }

  /* Select */
  .dv-select {
    position: relative;
    display: block;
  }

  .dv-select select {
    width: 100%;
    appearance: none;
    background: #2b2b2b;
    border: 1px solid #3d3d3d;
    color: #d8d8d8;
    font-size: 0.72rem;
    font-family: var(--font-body);
    padding: 0.2rem 1.4rem 0.2rem 0.5rem;
    height: 1.4rem;
  }

  .dv-caret {
    position: absolute;
    right: 0.4rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.6rem;
    color: #888;
    pointer-events: none;
  }

  /* Slider */
  .dv-slider {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dv-slider input[type='range'] {
    flex: 1;
    appearance: none;
    height: 1px;
    background: #4a4a4a;
    min-width: 0;
  }

  .dv-slider input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #ababab;
    cursor: grab;
  }

  .dv-slider input[type='range']::-moz-range-thumb {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #ababab;
    border: none;
    cursor: grab;
  }

  .dv-slider input[type='range']:active::-webkit-slider-thumb {
    background: var(--color-fg);
    cursor: grabbing;
  }

  .dv-value {
    width: 3.4rem;
    flex-shrink: 0;
    background: #232323;
    border: 1px solid #3d3d3d;
    color: #d8d8d8;
    font-size: 0.7rem;
    font-family: var(--font-body);
    text-align: right;
    padding: 0.15rem 0.35rem;
  }

  /* Button */
  .dv-button {
    width: 100%;
    background: #2b2b2b;
    border: 1px solid #3d3d3d;
    color: #d8d8d8;
    font-size: 0.72rem;
    font-family: var(--font-body);
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  .dv-button:hover,
  .dv-button:focus-visible {
    background: #353535;
    border-color: #555;
  }

  /* Shared caption slot -- same technique as ResolvePanel.astro, anchored
     to real rows instead of an image overlay, so alignment can't drift. */
  .dv-caption-slot {
    position: relative;
    min-height: 4.5rem;
  }

  .dv-caption-slot p {
    margin: 0;
    max-width: none;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .dv-caption-default {
    position: absolute;
    inset: 0;
    opacity: 1;
    color: var(--color-fg-muted);
    transition: opacity 0.12s ease;
  }

  .dv-caption {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.12s ease;
    color: var(--color-fg);
  }

  .dv-caption strong {
    color: var(--color-fg);
  }

  @media (max-width: 720px) {
    .dv-body {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('.resolve-panel .dv-row').forEach((row) => {
    const range = row.querySelector<HTMLInputElement>('input[type="range"]');
    const value = row.querySelector<HTMLInputElement>('.dv-value');
    if (range && value) {
      const decimals = value.value.includes('.') ? value.value.split('.')[1].length : 0;
      range.addEventListener('input', () => {
        value.value = Number(range.value).toFixed(decimals);
      });
    }
  });
</script>
