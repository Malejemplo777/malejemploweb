---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilmPerforations from '../components/FilmPerforations.astro';
import ProductSplit from '../components/ProductSplit.astro';
import gate24Wordmark from '../assets/brand/gate24-wordmark.png';
import { products } from '../data/products';

const wordmarks: Record<string, ImageMetadata> = {
  gate24: gate24Wordmark,
};

const splitProducts = products.map((product) => ({
  ...product,
  wordmark: wordmarks[product.slug],
}));
---

<BaseLayout
  title="Malejemplo"
  description="Film tools for DaVinci Resolve, made by Malejemplo. GATE.24 is out now."
>
  <section class="hero section">
    <FilmPerforations />
    <div class="container hero-inner">
      <p class="eyebrow">Malejemplo</p>
      <h1>Film tools, made by one person who edits too.</h1>
      <p class="lede">
        Malejemplo builds finishing tools for DaVinci Resolve — starting with GATE.24, a
        one-click cinematic look plugin. More products are on the way.
      </p>
    </div>
  </section>

  <section class="section products">
    <div class="container">
      <h2>Products</h2>
      <ProductSplit products={splitProducts} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-6);
  }

  .hero-inner {
    max-width: 42rem;
  }

  .lede {
    font-size: 1.1rem;
  }

  .products {
    padding-top: 0;
  }
</style>
