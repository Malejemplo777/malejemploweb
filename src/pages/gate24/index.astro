---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollIntro from '../../components/ScrollIntro.tsx';
import Library from '../../components/Library.tsx';
import LivePresetPlayground from '../../components/LivePresetPlayground.tsx';
import PresetGallery from '../../components/PresetGallery.tsx';
import ResolvePanel from '../../components/ResolvePanel.astro';
import { GUMROAD_LITE_URL, GUMROAD_PRO_URL } from '../../data/social';

const liteHref = GUMROAD_LITE_URL.length > 0 ? GUMROAD_LITE_URL : '#get';
const proHref = GUMROAD_PRO_URL;

const comparison = [
  { feature: 'Price', dehancer: 'Paid (subscription or lifetime)', flc: 'Included with Resolve Studio', gate24: 'Pay what you want (can be free)' },
  { feature: 'Multi-format crop bars', dehancer: 'Not listed (it has Overscan)', flc: 'Film-gate crop', gate24: 'Yes' },
  { feature: 'Vignette tied to lens character', dehancer: 'Film-style exposure vignette', flc: 'Amount and size only', gate24: 'Yes' },
  { feature: 'Grain by camera stock', dehancer: 'Yes (60+ stocks)', flc: 'Yes, by film type', gate24: 'Yes (8/16/35/65mm)' },
  { feature: 'Skin-tone protection', dehancer: 'No dedicated tool listed', flc: 'No', gate24: 'Yes, with per-shot eyedropper' },
  { feature: 'Ready-made presets', dehancer: '60+ film profiles; you build the look', flc: '8 built-in looks + custom', gate24: '10 (Essentials + Genre)' },
  { feature: 'Learning curve', dehancer: 'High', flc: 'Medium', gate24: 'One click, still hand-adjustable' },
];

const faq = [
  { q: 'Does it work on Mac?', a: 'Not yet. GATE.24 is Windows only for now; Mac support is blocked on hardware access, not ruled out.' },
  { q: 'How do I install it?', a: 'Unzip, run Install.bat, restart DaVinci Resolve and find GATE.24 in OpenFX. The installer runs in English or Spanish.' },
  { q: 'Can I have Lite and Pro installed together?', a: 'Yes. They are separate plugins and sit side by side in Resolve.' },
  { q: 'Is a preset locked once I apply it?', a: 'No. A preset is a starting point: every parameter stays adjustable by hand.' },
  { q: 'Why is the plugin panel in English?', a: 'The panel is English only. This site keeps the same names in every language so you can find them in Resolve.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GATE.24',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows',
  description:
    'One-click cinematic finishing plugin for DaVinci Resolve: multi-format crop bars, lens-tied vignette, film grain by camera stock, and skin-safe contrast.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Pay what you want',
  },
};
---

<BaseLayout
  title="GATE.24"
  description="GATE.24 is a one-click cinematic finishing plugin for DaVinci Resolve: multi-format crop bars, lens-tied vignette, film grain by camera stock, and skin-safe contrast. 10 presets included."
  ogImage="/og-gate24.jpg"
  theme="gate24"
  alternatePath="/es/gate24/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <ScrollIntro client:load lang="en" downloadHref={liteHref} />

  <section class="section" id="library">
    <div class="container">
      <h2>Eight shots, twelve looks</h2>
      <p>
        Real footage from one shoot, graded with GATE.24. Pick a shot, pick a look, then drag to
        compare it with the original.
      </p>
      <Library client:visible lang="en" />
    </div>
  </section>

  <section class="section" id="screencast">
    <div class="container">
      <h2>See it in Resolve</h2>
      <video
        class="screencast"
        src="/screencast.mp4"
        poster="/screencast-poster.jpg"
        controls
        preload="none"
        playsinline
        aria-label="GATE.24 panel walkthrough inside DaVinci Resolve"
      />
      <p class="fine-print">Real screen capture, not a mockup — presets, live parameter changes, and the diagnostic preview mode.</p>
    </div>
  </section>

  <section class="section" id="panel">
    <div class="container">
      <h2>Inside the panel</h2>
      <p>
        A recreation of the real GATE.24 controls, section by section — click a section to open it,
        hover a control to see what it does. Drag the sliders; they're just not wired to a real
        image here (that math only runs inside Resolve).
      </p>
      <ResolvePanel />
    </div>
  </section>

  <section class="section" id="presets">
    <div class="container">
      <h2>10 presets, two groups</h2>
      <p>
        <strong>Essentials</strong> for everyday cinema and editorial formats. <strong>Genre</strong>
        for a strong, deliberate mood. Every preset is a starting point — nothing is locked after
        you apply one.
      </p>
      <PresetGallery client:visible />
    </div>
  </section>

  <section class="section" id="comparison">
    <div class="container">
      <h2>How it compares</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Dehancer</th>
              <th scope="col">Film Look Creator</th>
              <th scope="col">GATE.24</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                <td>{row.dehancer}</td>
                <td>{row.flc}</td>
                <td class="highlight">{row.gate24}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p><a href="/guides/gate24-vs-dehancer-vs-film-look-creator/">Read the full comparison &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What else it does</h2>
      <ul class="feature-list">
        <li>
          <h3>Diagnostic preview</h3>
          <p>Overlay modes for vignette, grain, and skin-tone detection show exactly where and how hard each effect is acting — no more guessing.</p>
        </li>
        <li>
          <h3>Per-shot skin-tone calibration</h3>
          <p>Sample the real skin tone in a shot with a native color picker instead of relying on one fixed hue assumption.</p>
        </li>
        <li>
          <h3>GPU-accelerated</h3>
          <p>Runs on OpenCL — real-time preview, no render-to-check.</p>
        </li>
        <li>
          <h3>6 crop formats + custom</h3>
          <p>From 2.39:1 anamorphic cinema to 1:1 square, or set your own.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="playground">
    <div class="container">
      <h2>Try all 10 yourself</h2>
      <p>
        Pick a photo, pick a preset, see it live. This runs on CSS in your browser as a rough
        <strong>approximation</strong> of the real recipe values from each preset — a quick feel for
        the range, not GATE.24's actual color engine (that's C++/OpenCL pixel math that only runs
        inside Resolve). For the real thing, see the before/after examples and the panel above.
      </p>
      <LivePresetPlayground client:visible />
    </div>
  </section>

  <section class="section" id="get">
    <div class="container">
      <h2>Lite or Pro</h2>
      <p>Two plugins, installable side by side. Start with Lite; Pro adds everything below.</p>
      <div class="tiers">
        <article class="tier">
          <h3>GATE.24 Lite</h3>
          <p class="tier-price">Free</p>
          <ul>
            <li>5 presets: Cinema 35, Cinema 65, Editorial 4:3, Urban Editorial, Romance / Reverie</li>
            <li>Crop, vignette, grain, contrast, reframe, shadow lift and reset</li>
            <li>Every parameter still adjustable by hand</li>
          </ul>
          {liteHref !== '#get' ? (
            <a class="btn btn-primary" href={liteHref} target="_blank" rel="noopener noreferrer">Download Lite</a>
          ) : (
            <span class="btn btn-primary" aria-disabled="true">Download link coming soon</span>
          )}
        </article>
        <article class="tier tier-pro">
          <h3>GATE.24 Pro</h3>
          <p class="tier-price">Coming soon</p>
          <ul>
            <li>All 10 presets, including the genre looks</li>
            <li>Advanced controls and the diagnostic preview</li>
            <li>Weave and Flicker, for gate movement and exposure drift</li>
            <li>Skin-tone eyedropper, calibrated per shot</li>
          </ul>
          {proHref.length > 0 ? (
            <a class="btn btn-primary" href={proHref} target="_blank" rel="noopener noreferrer">Get Pro</a>
          ) : (
            <span class="btn btn-ghost" aria-disabled="true">Not available yet</span>
          )}
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <h2>Questions</h2>
      <dl class="faq">
        {faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="requirements">
    <div class="container">
      <h2>Requirements</h2>
      <dl class="requirements">
        <div>
          <dt>DaVinci Resolve</dt>
          <dd>Free version works — no Studio license required.</dd>
        </div>
        <div>
          <dt>Operating system</dt>
          <dd>Windows only for now. Mac support is blocked on hardware access, not ruled out.</dd>
        </div>
        <div>
          <dt>Language</dt>
          <dd>Plugin panel is in English. Installer runs in English or Spanish.</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .fine-print {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    margin-top: var(--space-2);
  }

  .screencast {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--color-border);
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-3);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  thead th {
    color: var(--color-fg-muted);
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  tbody th {
    font-weight: 600;
    color: var(--color-fg);
  }

  td.highlight {
    color: var(--color-fg);
    font-weight: 600;
  }

  .feature-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .feature-list h3 {
    font-size: 1.1rem;
  }

  .requirements {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .requirements dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .requirements dd {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 48rem;
  }

  .tiers {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  @media (min-width: 52rem) {
    .tiers {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
  }

  .tier-pro {
    border-color: var(--color-fg-muted);
  }

  .tier h3 {
    margin: 0;
  }

  .tier-price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-fg);
  }

  .tier ul {
    margin: 0 0 var(--space-2);
    padding-left: 1.1rem;
    color: var(--color-fg-muted);
    flex: 1;
  }

  .tier li {
    margin-bottom: 0.4rem;
  }

  .faq {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .faq dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .faq dd {
    margin: 0;
    color: var(--color-fg-muted);
  }
</style>
