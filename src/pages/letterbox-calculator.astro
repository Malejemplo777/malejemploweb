---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilmPerforations from '../components/FilmPerforations.astro';
import LetterboxCalculator from '../components/LetterboxCalculator.tsx';
import { calcBars, ratios } from '../lib/letterbox';
import { pagePath } from '../i18n';

const hd = { w: 1920, h: 1080 };
const uhd = { w: 3840, h: 2160 };

const rows = ratios.map((r) => ({
  label: r.label,
  hd: calcBars(hd.w, hd.h, r.value),
  uhd: calcBars(uhd.w, uhd.h, r.value),
}));

const kind = (m: string) => (m === 'letterbox' ? 'Top & bottom' : m === 'pillarbox' ? 'Left & right' : 'None');
const px = (n: number) => n.toLocaleString('en-US');

const faq = [
  {
    q: 'How big are the black bars for 2.39:1 on 1920×1080?',
    a: '138 px at the top and 138 px at the bottom. The picture left is about 1920×804.',
  },
  {
    q: 'Letterbox or pillarbox?',
    a: 'Letterbox is bars on top and bottom, for a ratio wider than your frame (2.39:1 on 16:9). Pillarbox is bars on the sides, for a narrower one (1:1 or 4:5 on 16:9).',
  },
  {
    q: 'Why is the resulting ratio not exactly 2.39?',
    a: 'Bars are whole pixels and equal on both sides, so the height is rounded. The difference is invisible.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Letterbox calculator',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (runs in the browser)',
    inLanguage: 'en',
    description:
      'Free calculator that gives you the exact pixel size of the black bars (letterbox or pillarbox) for any video resolution and aspect ratio.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Letterbox calculator: black bar size in pixels"
  description="Free letterbox and pillarbox calculator. Pick your resolution and an aspect ratio (2.39:1, 2.35:1, 1.85:1, 1:1, 4:5, 9:16) and get the exact black bar size in pixels."
  alternatePath="/es/calculadora-barras-negras/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero section">
    <FilmPerforations />
    <div class="container hero-inner">
      <p class="eyebrow">Free tool &middot; by Malejemplo</p>
      <h1>Letterbox calculator</h1>
      <p class="lede">Pick a size and a ratio. Get the black bars in pixels.</p>
    </div>
  </section>

  <section class="calc-section">
    <div class="container">
      <LetterboxCalculator client:load lang="en" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>The formula</h2>
      <p class="formula">visible height = width ÷ ratio<br />bar = (height − visible height) ÷ 2</p>
      <p>1920×1080 at 2.39:1: 1920 ÷ 2.39 ≈ 803, so (1080 − 803) ÷ 2 ≈ <strong>138 px</strong> per bar.</p>
    </div>
  </section>

  <section class="section table-section">
    <div class="container">
      <h2>Common ratios, ready to read</h2>
      <p>Bar per side, in pixels, on a 16:9 frame.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Ratio</th>
              <th scope="col">Bars</th>
              <th scope="col">1920×1080</th>
              <th scope="col">3840×2160</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{kind(r.hd.mode)}</td>
                <td>{px(r.hd.bar)} px <span class="dim">→ {r.hd.visibleW}×{r.hd.visibleH}</span></td>
                <td>{px(r.uhd.bar)} px <span class="dim">→ {r.uhd.visibleW}×{r.uhd.visibleH}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>In DaVinci Resolve</h2>
      <ol class="steps">
        <li><strong>Timeline › Output Blanking.</strong> Pick a ratio from the list.</li>
        <li><strong>Inspector › Cropping.</strong> Type the bar size in Crop Top and Crop Bottom (Left and Right for pillarbox).</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>FAQ</h2>
      <dl class="faq">
        {faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section cta">
    <div class="container narrow">
      <h2>Skip the maths</h2>
      <p>GATE.24 puts the bars on for you: 6 crop formats from 2.39:1 to 1:1, inside DaVinci Resolve.</p>
      <p><a class="btn btn-primary" href={pagePath('gate24', 'en')}>See GATE.24</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
    text-align: center;
  }
  .hero-inner {
    max-width: 44rem;
    margin-inline: auto;
  }
  .hero .eyebrow {
    margin-inline: auto;
  }
  .lede {
    font-size: 1.1rem;
    margin-inline: auto;
  }
  .calc-section {
    padding-bottom: var(--space-5);
  }
  .narrow {
    max-width: 44rem;
  }
  .formula {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace;
    color: var(--color-fg);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    padding: 1rem 1.25rem;
    line-height: 1.8;
    max-width: none;
  }
  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-3);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 36rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  thead th {
    color: var(--color-fg-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  tbody th {
    font-weight: 600;
  }
  .dim {
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    margin-left: 0.25rem;
  }
  .steps {
    color: var(--color-fg-muted);
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }
  .steps strong {
    color: var(--color-fg);
  }
  .faq {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
  }
  .faq dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }
  .faq dd {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .cta {
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .cta .narrow p {
    margin-inline: auto;
  }
</style>
