---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticle from '../../components/GuideArticle.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  const translations = await getCollection('guidesEs');
  return entries.map((entry) => {
    const es = translations.find((t) => t.data.translationOf === entry.id);
    return {
      params: { slug: entry.id },
      props: { entry, alternatePath: es ? `/es/guias/${es.id}/` : undefined },
    };
  });
}

const { entry, alternatePath } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} alternatePath={alternatePath}>
  <GuideArticle title={entry.data.title} description={entry.data.description} cover={entry.data.cover}>
    <Content />
  </GuideArticle>
</BaseLayout>
