---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCards from '../../components/GuideCards.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const cards = entries.map((entry) => ({
  href: `/guides/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  cover: entry.data.cover,
}));
---

<BaseLayout
  title="Guides"
  description="Practical guides on getting a cinematic look in DaVinci Resolve, and how GATE.24 compares to other finishing tools."
  alternatePath="/es/guias/"
>
  <PageHero
    title="Practical guides for a cinematic look."
    lede="A small, fixed set of guides: how to get a film look in DaVinci Resolve, and how GATE.24 compares to other tools."
  />
  <section class="section" style="padding-top: var(--space-3)">
    <div class="container">
      <GuideCards entries={cards} featureFirst />
    </div>
  </section>
</BaseLayout>
