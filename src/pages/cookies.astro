---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cookie policy" description="Which cookies this site uses and why.">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Legal</p>
      <h1>Cookie policy</h1>
      <p class="fine-print">Last updated September 2026.</p>

      <h2>Analytics cookies (optional)</h2>
      <p>
        We use Google Analytics to see which pages get traffic and where visitors come from. These
        cookies are <strong>not</strong> set until you click "Accept" on the cookie banner. You can
        change your mind at any time — click "Cookie settings" in the footer of any page to reopen
        the banner and switch between accept/decline, no need to clear your browser cookies.
      </p>

      <h2>No advertising or tracking cookies</h2>
      <p>We don't run ads and don't use third-party tracking/retargeting cookies on this site.</p>

      <h2>Forms and downloads</h2>
      <p>
        The newsletter and contact forms submit directly to Formspree; GATE.24 downloads and payments
        go through Gumroad. Neither sets a cookie on this site — any cookie they set happens on their
        own pages, under their own cookie policies.</p>
      <p>
        This site is hosted on GitHub Pages, which doesn't set cookies either, though it does log
        requests (including IP address) on its own servers to run the hosting service.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 40rem;
  }

  .fine-print {
    font-size: 0.8rem;
    color: var(--color-fg-muted);
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-2);
  }
</style>
