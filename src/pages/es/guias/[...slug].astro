---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideArticle from '../../../components/GuideArticle.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('guidesEs');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, alternatePath: `/guides/${entry.data.translationOf}/` },
  }));
}

const { entry, alternatePath } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} alternatePath={alternatePath}>
  <GuideArticle title={entry.data.title} description={entry.data.description} cover={entry.data.cover} lang="es">
    <Content />
  </GuideArticle>
</BaseLayout>
