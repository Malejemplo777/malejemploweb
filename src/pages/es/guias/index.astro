---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import GuideCards from '../../../components/GuideCards.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('guidesEs')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const cards = entries.map((entry) => ({
  href: `/es/guias/${entry.id}/`,
  title: entry.data.title,
  description: entry.data.description,
  cover: entry.data.cover,
}));
---

<BaseLayout
  title="Guías"
  description="Guías prácticas para conseguir un look cinematográfico en DaVinci Resolve y para ver cómo se compara GATE.24 con otras herramientas de acabado."
  alternatePath="/guides/"
>
  <PageHero
    title="Guías prácticas para un look de cine."
    lede="Un conjunto pequeño y cerrado de guías: cómo conseguir un look de película en DaVinci Resolve y cómo se compara GATE.24 con otras herramientas."
    lang="es"
  />
  <section class="section" style="padding-top: var(--space-3)">
    <div class="container">
      <GuideCards entries={cards} lang="es" featureFirst />
    </div>
  </section>
</BaseLayout>
