---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import { social } from '../../data/social';
import { pagePath } from '../../i18n';
---

<BaseLayout
  title="Sobre Malejemplo"
  description="Malejemplo es la marca personal de alguien que edita en DaVinci Resolve, crea contenido en YouTube y hace herramientas de acabado, empezando por GATE.24."
  alternatePath="/about/"
>
  <PageHero
    title="Plugins hechos por alguien que edita metraje real."
    lede="Malejemplo es un taller de una sola persona que hace herramientas de acabado para DaVinci Resolve. No un estudio de plugins que trabaja con una hoja de especificaciones."
    cover="m02-original"
    caption={false}
    lang="es"
  />

  <section class="section facts">
    <div class="container">
      <dl>
        <div>
          <dt>Qué hago</dt>
          <dd>Herramientas de acabado para DaVinci Resolve: barras de recorte, viñeta, grano y contraste.</dd>
        </div>
        <div>
          <dt>Cómo las hago</dt>
          <dd>Edito y etalono metraje real todos los días, y construyo lo que me sigue faltando.</dd>
        </div>
        <div>
          <dt>Qué viene</dt>
          <dd>GATE.24 es el primer lanzamiento; habrá más herramientas.</dd>
        </div>
      </dl>
      <p class="links">
        <a class="btn btn-primary" href={pagePath('gate24', 'es')}>Ver GATE.24</a>
        {social.youtube && (
          <a class="btn btn-ghost" href={social.youtube} target="_blank" rel="noopener noreferrer">Ver el canal de YouTube</a>
        )}
      </p>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container narrow">
      <h2>Contacto</h2>
      <p>Dudas, errores, ideas para nuevas funciones: escríbeme con este formulario.</p>
      <ContactForm lang="es" />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: var(--content-width);
  }

  .narrow > :global(*) {
    max-width: 40rem;
  }

  .facts {
    padding-top: var(--space-4);
  }

  dl {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-4);
  }

  dt {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--color-fg-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (min-width: 52rem) {
    dl {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }
</style>
