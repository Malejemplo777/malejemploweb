---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { social } from '../../data/social';
---

<BaseLayout
  title="Sobre Malejemplo"
  description="Malejemplo es la marca personal de alguien que edita en DaVinci Resolve, crea contenido en YouTube y hace herramientas de acabado, empezando por GATE.24."
  alternatePath="/about/"
>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Sobre Malejemplo</p>
      <h1>Malejemplo</h1>
      <p>
        Malejemplo es un taller de una sola persona que hace herramientas de acabado para DaVinci
        Resolve. Son plugins pensados por alguien que edita y etalona metraje real todos los días,
        no por un estudio que trabaja con una hoja de especificaciones. GATE.24 es el primero;
        habrá más.
      </p>
      {social.youtube ? (
        <p><a class="btn btn-ghost" href={social.youtube} target="_blank" rel="noopener noreferrer">Ver el canal de YouTube</a></p>
      ) : (
        <p class="fine-print">Enlace de YouTube pendiente.</p>
      )}
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container narrow">
      <h2>Contacto</h2>
      <p>Dudas, errores, ideas para nuevas funciones: escríbeme con este formulario.</p>
      <ContactForm lang="es" />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 40rem;
  }

  .fine-print {
    font-size: 0.8rem;
    color: var(--color-fg-muted);
  }
</style>
