---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { social } from '../../data/social';
---

<BaseLayout
  title="Acerca de"
  description="Malejemplo es la marca personal de un editor de DaVinci Resolve y creador de YouTube que crea herramientas de acabado, empezando por GATE.24."
  alternatePath="/about/"
>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Acerca de</p>
      <h1>Malejemplo</h1>
      <p>
        Malejemplo es un taller de una sola persona que crea herramientas de acabado para DaVinci
        Resolve — plugins hechos por alguien que edita y colorea metraje real, no por un estudio de
        plugins que trabaja desde una hoja de especificaciones. GATE.24 es el primer lanzamiento;
        hay más herramientas en camino.
      </p>
      {social.youtube ? (
        <p><a class="btn btn-ghost" href={social.youtube} target="_blank" rel="noopener noreferrer">Ver en YouTube</a></p>
      ) : (
        <p class="fine-print">Enlace de YouTube pendiente.</p>
      )}
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container narrow">
      <h2>Contacto</h2>
      <p>Preguntas, errores, peticiones de funciones — usa el formulario de abajo.</p>
      <ContactForm lang="es" />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 40rem;
  }

  .fine-print {
    font-size: 0.8rem;
    color: var(--color-fg-muted);
  }
</style>
