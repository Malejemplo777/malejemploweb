---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScrollIntro from '../../../components/ScrollIntro.tsx';
import Library from '../../../components/Library.tsx';
import LivePresetPlayground from '../../../components/LivePresetPlayground.tsx';
import PresetGallery from '../../../components/PresetGallery.tsx';
import ResolvePanel from '../../../components/ResolvePanel.astro';
import { GUMROAD_URL, GUMROAD_LITE_URL } from '../../../data/social';

const liteHref = GUMROAD_LITE_URL;
const fullHref = GUMROAD_URL;

const comparison = [
  { feature: 'Precio', dehancer: 'De pago (suscripción o licencia vitalicia)', flc: 'Incluido en Resolve Studio', gate24: '12,99 € de pago único (Lite es gratis)' },
  { feature: 'Barras de recorte multiformato', dehancer: 'No consta (tiene Overscan)', flc: 'Recorte tipo film gate', gate24: 'Sí' },
  { feature: 'Viñeta según el tipo de óptica', dehancer: 'Viñeta de exposición tipo película', flc: 'Solo cantidad y tamaño', gate24: 'Sí' },
  { feature: 'Grano según la película', dehancer: 'Sí (más de 60 películas)', flc: 'Sí, según el tipo de película', gate24: 'Sí (8, 16, 35 y 65 mm)' },
  { feature: 'Protección de la piel', dehancer: 'Sin herramienta específica indicada', flc: 'No', gate24: 'Sí, con cuentagotas en cada plano' },
  { feature: 'Presets listos para usar', dehancer: 'Más de 60 perfiles de película; el look lo montas tú', flc: '8 looks integrados + uno personalizado', gate24: '10 (Essentials + Genre)' },
  { feature: 'Curva de aprendizaje', dehancer: 'Alta', flc: 'Media', gate24: 'Un clic, y todo sigue siendo ajustable a mano' },
];

const faq = [
  { q: '¿Funciona en Mac?', a: 'Todavía no. GATE.24 es solo para Windows por ahora; Mac no está descartado, pero de momento no hay hardware para probarlo.' },
  { q: '¿Cómo se instala?', a: 'Descomprime, ejecuta Install.bat, reinicia DaVinci Resolve y busca GATE.24 en OpenFX. El instalador funciona en inglés o en español.' },
  { q: '¿Puedo tener Lite y GATE.24 instalados a la vez?', a: 'Sí. Son plugins distintos y conviven en Resolve.' },
  { q: '¿Un preset queda bloqueado al aplicarlo?', a: 'No. Un preset es solo un punto de partida: todos los parámetros se pueden ajustar a mano.' },
  { q: '¿Por qué el panel del plugin está en inglés?', a: 'El panel solo existe en inglés. Esta web mantiene los mismos nombres en todos los idiomas para que los encuentres en Resolve.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GATE.24',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows',
  inLanguage: 'es',
  description:
    'Plugin de acabado cinematográfico en un clic para DaVinci Resolve: barras de recorte multiformato, viñeta que imita la óptica, grano de película según el negativo y contraste que respeta la piel.',
  offers: [
    { '@type': 'Offer', name: 'GATE.24', price: '12.99', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'GATE.24 Lite', price: '0', priceCurrency: 'EUR' },
  ],
};
---

<BaseLayout
  title="GATE.24"
  description="GATE.24 es un plugin de acabado cinematográfico en un clic para DaVinci Resolve: barras de recorte multiformato, viñeta que imita la óptica, grano de película según el negativo y contraste que respeta la piel. Incluye 10 presets."
  ogImage="/og-gate24.jpg"
  theme="gate24"
  alternatePath="/gate24/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <ScrollIntro client:load lang="es" downloadHref="#get" liteHref={liteHref} fullHref={fullHref} />

  <section class="section" id="library">
    <div class="container">
      <h2>Ocho planos, doce looks</h2>
      <p>
        Metraje real de un mismo rodaje, etalonado con GATE.24. Elige un plano, elige un look y
        arrastra para compararlo con el original.
      </p>
      <Library client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="movement">
    <div class="container">
      <h2>Weave y Flicker, de verdad</h2>
      <p>Weave hace que el fotograma salte como en un proyector de película; Flicker hace que la exposición pulse de un fotograma a otro. Este es el clip real: los ocho planos con los dos activados.</p>
      <video
        class="movement"
        src="/video/weave-flicker.mp4"
        poster="/video/weave-flicker-poster.jpg"
        controls
        muted
        loop
        playsinline
        preload="none"
        aria-label="Los ocho planos con Weave y Flicker de GATE.24 aplicados"
      ></video>
      <p class="fine-print">Metraje real, renderizado desde DaVinci Resolve. No está en Lite.</p>
    </div>
  </section>

  <section class="section" id="panel">
    <div class="container">
      <h2>Dentro del panel</h2>
      <p>
        Una recreación de los controles reales de GATE.24, sección por sección. Abre cada sección
        con un clic y pasa el ratón por un control para ver qué hace. Los deslizadores se mueven,
        pero aquí no están conectados a ninguna imagen (ese cálculo solo ocurre dentro de Resolve).
        Los nombres de los controles están en inglés porque el panel real del plugin también lo
        está.
      </p>
      <ResolvePanel lang="es" />
    </div>
  </section>

  <section class="section" id="presets">
    <div class="container">
      <h2>10 presets en dos grupos</h2>
      <p>
        <strong>Essentials</strong> es para el cine de uso diario y los formatos editoriales. <strong>Genre</strong> es para ambientes con una personalidad muy marcada. Cada
        preset es solo un punto de partida: después de aplicarlo no queda nada bloqueado.
      </p>
      <PresetGallery client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="comparison">
    <div class="container">
      <h2>Cómo se compara</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Característica</th>
              <th scope="col">Dehancer</th>
              <th scope="col">Film Look Creator</th>
              <th scope="col">GATE.24</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                <td>{row.dehancer}</td>
                <td>{row.flc}</td>
                <td class="highlight">{row.gate24}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p><a href="/es/guias/gate24-vs-dehancer-vs-film-look-creator/">Lee la comparativa completa &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Qué más hace</h2>
      <ul class="feature-list">
        <li>
          <h3>Vista previa de diagnóstico</h3>
          <p>Los modos de superposición de viñeta, grano y detección de piel te enseñan exactamente dónde actúa cada efecto y con qué fuerza. Se acabó ir a ojo.</p>
        </li>
        <li>
          <h3>Calibración de piel en cada plano</h3>
          <p>Toma el tono de piel real de un plano con un selector de color nativo, en vez de fiarte de un único tono fijo.</p>
        </li>
        <li>
          <h3>Acelerado por GPU</h3>
          <p>Funciona con OpenCL: vista previa en tiempo real, sin tener que renderizar para comprobar el resultado.</p>
        </li>
        <li>
          <h3>6 formatos de recorte + personalizado</h3>
          <p>Desde el 2.39:1 anamórfico del cine hasta el 1:1 cuadrado, o define el tuyo.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="playground">
    <div class="container">
      <h2>Prueba los 10 tú mismo</h2>
      <p>
        Elige una foto, elige un preset y míralo en directo. Esto funciona con CSS en tu navegador y
        es solo una <strong>aproximación</strong> de los valores reales de cada preset: sirve para
        hacerte una idea del rango, pero no es el motor de color de GATE.24 (eso es cálculo de
        píxeles en C++/OpenCL y solo corre dentro de Resolve). Para ver el resultado real, mira los
        ejemplos de antes y después y el panel de más arriba.
      </p>
      <LivePresetPlayground client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="get">
    <div class="container">
      <h2>Lite o el GATE.24 completo</h2>
      <p>Dos plugins que se instalan a la vez. Empieza con Lite; el GATE.24 completo añade todo lo de abajo.</p>
      <div class="tiers">
        <article class="tier">
          <h3>GATE.24 Lite</h3>
          <p class="tier-price">Gratis</p>
          <ul>
            <li>5 presets: Cinema 35, Cinema 65, Editorial 4:3, Urban Editorial y Romance / Reverie</li>
            <li>Crop, vignette, grain, contrast, reframe, shadow lift y reset</li>
            <li>Cada parámetro se sigue ajustando a mano</li>
          </ul>
          {liteHref.length > 0 ? (
            <a class="btn btn-primary" href={liteHref} target="_blank" rel="noopener noreferrer">Conseguir Lite</a>
          ) : (
            <span class="btn btn-primary" aria-disabled="true">Enlace próximamente</span>
          )}
        </article>
        <article class="tier tier-full">
          <h3>GATE.24</h3>
          <p class="tier-price">12,99 € · pago único</p>
          <ul>
            <li>Los 10 presets, incluidos los de género</li>
            <li>Controles avanzados y vista previa de diagnóstico</li>
            <li>Weave y Flicker, para el movimiento del fotograma y la deriva de exposición</li>
            <li>Cuentagotas de piel, calibrado en cada plano</li>
          </ul>
          {fullHref.length > 0 ? (
            <a class="btn btn-primary" href={fullHref} target="_blank" rel="noopener noreferrer">Conseguir GATE.24</a>
          ) : (
            <span class="btn btn-primary" aria-disabled="true">Enlace próximamente</span>
          )}
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <h2>Preguntas</h2>
      <dl class="faq">
        {faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="requirements">
    <div class="container">
      <h2>Requisitos</h2>
      <dl class="requirements">
        <div>
          <dt>DaVinci Resolve</dt>
          <dd>Vale la versión gratuita; no hace falta la licencia Studio.</dd>
        </div>
        <div>
          <dt>Sistema operativo</dt>
          <dd>Solo Windows por ahora. Mac no está descartado, pero de momento no hay hardware para probarlo.</dd>
        </div>
        <div>
          <dt>Idioma</dt>
          <dd>El panel del plugin está en inglés. El instalador funciona en inglés o en español.</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .fine-print {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    margin-top: var(--space-2);
  }

  .movement {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: var(--space-3);
    background: #000;
    border: 1px solid var(--color-border);
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-3);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  thead th {
    color: var(--color-fg-muted);
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  tbody th {
    font-weight: 600;
    color: var(--color-fg);
  }

  td.highlight {
    color: var(--color-fg);
    font-weight: 600;
  }

  .feature-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .feature-list h3 {
    font-size: 1.1rem;
  }

  .requirements {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .requirements dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .requirements dd {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 48rem;
  }

  .tiers {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  @media (min-width: 52rem) {
    .tiers {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
  }

  .tier-full {
    border-color: var(--color-fg-muted);
  }

  .tier h3 {
    margin: 0;
  }

  .tier-price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-fg);
  }

  .tier ul {
    margin: 0 0 var(--space-2);
    padding-left: 1.1rem;
    color: var(--color-fg-muted);
    flex: 1;
  }

  .tier li {
    margin-bottom: 0.4rem;
  }

  .faq {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .faq dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .faq dd {
    margin: 0;
    color: var(--color-fg-muted);
  }
</style>
