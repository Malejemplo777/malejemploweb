---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilmPerforations from '../../../components/FilmPerforations.astro';
import PresetShowcase from '../../../components/PresetShowcase.tsx';
import LivePresetPlayground from '../../../components/LivePresetPlayground.tsx';
import PresetGallery from '../../../components/PresetGallery.tsx';
import ResolvePanel from '../../../components/ResolvePanel.astro';
import { Image } from 'astro:assets';
import wordmark from '../../../assets/brand/gate24-wordmark.png';
import { GUMROAD_URL } from '../../../data/social';

const hasGumroad = GUMROAD_URL.length > 0;

const comparison = [
  { feature: 'Precio', dehancer: '$500+', flc: 'Gratis', gate24: 'Paga lo que quieras (puede ser gratis)' },
  { feature: 'Barras de recorte multiformato', dehancer: 'No', flc: 'No', gate24: 'Sí' },
  { feature: 'Viñeta ligada al carácter de la óptica', dehancer: 'Genérica', flc: 'Genérica', gate24: 'Sí' },
  { feature: 'Grano según el negativo de cámara', dehancer: 'Sí (más de 60 negativos)', flc: 'Un grano genérico', gate24: 'Sí (8/16/35/65 mm)' },
  { feature: 'Protección de tonos de piel', dehancer: 'No es su foco', flc: 'No', gate24: 'Sí, con cuentagotas por plano' },
  { feature: 'Presets listos para usar', dehancer: 'Pocos, construyes tú el look', flc: '7 genéricos', gate24: '13 (Essentials + Genre)' },
  { feature: 'Curva de aprendizaje', dehancer: 'Alta', flc: 'Media', gate24: 'Un clic, y sigue siendo ajustable a mano' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GATE.24',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows',
  inLanguage: 'es',
  description:
    'Plugin de acabado cinematográfico en un clic para DaVinci Resolve: barras de recorte multiformato, viñeta ligada a la óptica, grano de película según el negativo y contraste que protege la piel.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Paga lo que quieras',
  },
};
---

<BaseLayout
  title="GATE.24"
  description="GATE.24 es un plugin de acabado cinematográfico en un clic para DaVinci Resolve: barras de recorte multiformato, viñeta ligada a la óptica, grano de película según el negativo y contraste que protege la piel. 13 presets incluidos."
  ogImage="/og-gate24.jpg"
  theme="gate24"
  alternatePath="/gate24/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero section">
    <FilmPerforations />
    <div class="container hero-inner">
      <Image src={wordmark} alt="GATE.24" width={180} height={180} class="hero-mark" />
      <p class="eyebrow">por Malejemplo &middot; plugin OFX para DaVinci Resolve</p>
      <h1>Todo lo que hace un plugin de $500+ por tu corrección de color — sin pagar su precio.</h1>
      <p class="lede">
        Un solo efecto para recorte, viñeta ligada a la óptica, grano según el negativo y contraste
        que protege la piel — 13 presets incluidos, y cada parámetro sigue siendo ajustable a mano.
        Paga lo que quieras, incluso nada.
      </p>
      <div class="cta-row">
        {hasGumroad ? (
          <a class="btn btn-primary" href={GUMROAD_URL} target="_blank" rel="noopener noreferrer">Conseguir GATE.24</a>
        ) : (
          <span class="btn btn-primary" aria-disabled="true">Enlace de descarga próximamente</span>
        )}
        <a class="btn btn-ghost" href="#comparison">Ver cómo se compara</a>
        <a class="btn btn-text" href="/gate24/manual.html" download>Descargar manual</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Elige un ambiente, mira la diferencia</h2>
      <p>El mismo plugin, cinco resultados muy distintos. Elige un preset y arrastra para comparar.</p>
      <PresetShowcase client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="screencast">
    <div class="container">
      <h2>Míralo en Resolve</h2>
      <video
        class="screencast"
        src="/screencast.mp4"
        poster="/screencast-poster.jpg"
        controls
        preload="none"
        playsinline
        aria-label="Recorrido por el panel de GATE.24 dentro de DaVinci Resolve"
      />
      <p class="fine-print">Captura de pantalla real, no una maqueta — presets, cambios de parámetros en vivo y el modo de vista previa de diagnóstico.</p>
    </div>
  </section>

  <section class="section" id="panel">
    <div class="container">
      <h2>Dentro del panel</h2>
      <p>
        Una recreación de los controles reales de GATE.24, sección por sección — haz clic en una
        sección para abrirla y pasa el cursor sobre un control para ver qué hace. Mueve los
        deslizadores; simplemente no están conectados a una imagen real aquí (ese cálculo solo se
        ejecuta dentro de Resolve). Los nombres de los controles se quedan en inglés porque el panel
        real del plugin está en inglés.
      </p>
      <ResolvePanel lang="es" />
    </div>
  </section>

  <section class="section" id="presets">
    <div class="container">
      <h2>13 presets, dos grupos</h2>
      <p>
        <strong>Essentials</strong> para cine de uso diario y formatos editoriales y sociales.
        <strong>Genre</strong> para un ambiente marcado y deliberado. Cada preset es un punto de
        partida — nada queda bloqueado después de aplicarlo.
      </p>
      <PresetGallery client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="comparison">
    <div class="container">
      <h2>Cómo se compara</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Característica</th>
              <th scope="col">Dehancer</th>
              <th scope="col">Film Look Creator</th>
              <th scope="col">GATE.24</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                <td>{row.dehancer}</td>
                <td>{row.flc}</td>
                <td class="highlight">{row.gate24}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p><a href="/es/guias/gate24-vs-dehancer-vs-film-look-creator/">Lee la comparativa completa &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Qué más hace</h2>
      <ul class="feature-list">
        <li>
          <h3>Vista previa de diagnóstico</h3>
          <p>Los modos de superposición para viñeta, grano y detección de tonos de piel muestran exactamente dónde y con qué fuerza actúa cada efecto — se acabó adivinar.</p>
        </li>
        <li>
          <h3>Calibración de piel por plano</h3>
          <p>Muestrea el tono de piel real de un plano con un selector de color nativo, en vez de depender de un único tono fijo.</p>
        </li>
        <li>
          <h3>Acelerado por GPU</h3>
          <p>Funciona sobre OpenCL — vista previa en tiempo real, sin renderizar para comprobar.</p>
        </li>
        <li>
          <h3>9 formatos de recorte</h3>
          <p>Del cine anamórfico 2.39:1 al vertical 9:16 para redes sociales.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="playground">
    <div class="container">
      <h2>Pruébalos los 13 tú mismo</h2>
      <p>
        Elige una foto, elige un preset y míralo en vivo. Esto funciona con CSS en tu navegador como
        una <strong>aproximación</strong> de los valores reales de cada preset — una idea rápida del
        rango, no el motor de color real de GATE.24 (eso es cálculo de píxeles en C++/OpenCL que
        solo se ejecuta dentro de Resolve). Para ver lo real, mira los ejemplos de antes y después
        y el panel de arriba.
      </p>
      <LivePresetPlayground client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="requirements">
    <div class="container">
      <h2>Requisitos</h2>
      <dl class="requirements">
        <div>
          <dt>DaVinci Resolve</dt>
          <dd>Funciona con la versión gratuita — no hace falta licencia Studio.</dd>
        </div>
        <div>
          <dt>Sistema operativo</dt>
          <dd>Solo Windows por ahora. El soporte para Mac depende de conseguir hardware, no está descartado.</dd>
        </div>
        <div>
          <dt>Idioma</dt>
          <dd>El panel del plugin está en inglés. El instalador funciona en inglés o en español.</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-5);
    text-align: center;
  }

  .hero-inner {
    max-width: 40rem;
    margin-inline: auto;
  }

  .hero-mark {
    margin-inline: auto;
    margin-bottom: var(--space-2);
  }

  /* .eyebrow (global.css) has no margin-inline: auto, since it stays
     left-aligned everywhere else it's used (home, about, guides). Inside
     this centered hero it needs its own centering or it hugs the left edge
     of its max-width: 60ch box instead of the hero's true center. */
  .hero .eyebrow {
    margin-inline: auto;
  }

  .lede {
    font-size: 1.1rem;
    margin-inline: auto;
  }

  .cta-row {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .fine-print {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin-top: var(--space-2);
  }

  .screencast {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--color-border);
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-3);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  thead th {
    color: var(--color-fg-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  tbody th {
    font-weight: 600;
    color: var(--color-fg);
  }

  td.highlight {
    color: var(--color-fg);
    font-weight: 600;
  }

  .feature-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .feature-list h3 {
    font-size: 1.1rem;
  }

  .requirements {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .requirements dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .requirements dd {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 48rem;
  }
</style>
