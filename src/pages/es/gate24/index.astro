---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilmPerforations from '../../../components/FilmPerforations.astro';
import PresetShowcase from '../../../components/PresetShowcase.tsx';
import LivePresetPlayground from '../../../components/LivePresetPlayground.tsx';
import PresetGallery from '../../../components/PresetGallery.tsx';
import ResolvePanel from '../../../components/ResolvePanel.astro';
import { Image } from 'astro:assets';
import wordmark from '../../../assets/brand/gate24-wordmark.png';
import { GUMROAD_URL } from '../../../data/social';

const hasGumroad = GUMROAD_URL.length > 0;

const comparison = [
  { feature: 'Precio', dehancer: 'De pago (suscripción o licencia vitalicia)', flc: 'Incluido en Resolve Studio', gate24: 'Paga lo que quieras (puede ser gratis)' },
  { feature: 'Barras de recorte multiformato', dehancer: 'No', flc: 'Recorte tipo film gate', gate24: 'Sí' },
  { feature: 'Viñeta según el tipo de óptica', dehancer: 'Genérica', flc: 'Genérica', gate24: 'Sí' },
  { feature: 'Grano según la película', dehancer: 'Sí (más de 60 películas)', flc: 'Un único grano genérico', gate24: 'Sí (8, 16, 35 y 65 mm)' },
  { feature: 'Protección de la piel', dehancer: 'No es su fuerte', flc: 'No', gate24: 'Sí, con cuentagotas en cada plano' },
  { feature: 'Presets listos para usar', dehancer: 'Pocos, el look lo montas tú', flc: 'Unos pocos looks integrados', gate24: '13 (Essentials + Genre)' },
  { feature: 'Curva de aprendizaje', dehancer: 'Alta', flc: 'Media', gate24: 'Un clic, y todo sigue siendo ajustable a mano' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GATE.24',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows',
  inLanguage: 'es',
  description:
    'Plugin de acabado cinematográfico en un clic para DaVinci Resolve: barras de recorte multiformato, viñeta que imita la óptica, grano de película según el negativo y contraste que respeta la piel.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Paga lo que quieras',
  },
};
---

<BaseLayout
  title="GATE.24"
  description="GATE.24 es un plugin de acabado cinematográfico en un clic para DaVinci Resolve: barras de recorte multiformato, viñeta que imita la óptica, grano de película según el negativo y contraste que respeta la piel. Incluye 13 presets."
  ogImage="/og-gate24.jpg"
  theme="gate24"
  alternatePath="/gate24/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero section">
    <FilmPerforations />
    <div class="container hero-inner">
      <Image src={wordmark} alt="GATE.24" width={180} height={180} class="hero-mark" />
      <p class="eyebrow">por Malejemplo &middot; plugin OFX para DaVinci Resolve</p>
      <h1>Todo lo que hace un plugin de más de 500 $ por tu etalonaje, sin pagar ese precio.</h1>
      <p class="lede">
        Un solo efecto para el recorte, la viñeta según la óptica, el grano según la película y un
        contraste que respeta la piel. Incluye 13 presets y puedes ajustar cada parámetro a mano.
        Paga lo que quieras, aunque sea nada.
      </p>
      <div class="cta-row">
        {hasGumroad ? (
          <a class="btn btn-primary" href={GUMROAD_URL} target="_blank" rel="noopener noreferrer">Conseguir GATE.24</a>
        ) : (
          <span class="btn btn-primary" aria-disabled="true">Descarga disponible pronto</span>
        )}
        <a class="btn btn-ghost" href="#comparison">Ver cómo se compara</a>
        <a class="btn btn-text" href="/gate24/manual.html" download>Descargar manual</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Elige un ambiente y mira la diferencia</h2>
      <p>El mismo plugin con cinco resultados muy distintos. Elige un preset y arrastra para comparar.</p>
      <PresetShowcase client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="screencast">
    <div class="container">
      <h2>Míralo en acción en Resolve</h2>
      <video
        class="screencast"
        src="/screencast.mp4"
        poster="/screencast-poster.jpg"
        controls
        preload="none"
        playsinline
        aria-label="Recorrido por el panel de GATE.24 dentro de DaVinci Resolve"
      />
      <p class="fine-print">Es una grabación de pantalla real, no una maqueta: presets, cambios de parámetros en directo y el modo de vista previa de diagnóstico.</p>
    </div>
  </section>

  <section class="section" id="panel">
    <div class="container">
      <h2>Dentro del panel</h2>
      <p>
        Una recreación de los controles reales de GATE.24, sección por sección. Abre cada sección
        con un clic y pasa el ratón por un control para ver qué hace. Los deslizadores se mueven,
        pero aquí no están conectados a ninguna imagen (ese cálculo solo ocurre dentro de Resolve).
        Los nombres de los controles están en inglés porque el panel real del plugin también lo
        está.
      </p>
      <ResolvePanel lang="es" />
    </div>
  </section>

  <section class="section" id="presets">
    <div class="container">
      <h2>13 presets en dos grupos</h2>
      <p>
        <strong>Essentials</strong> es para el cine de uso diario y los formatos editoriales y de
        redes. <strong>Genre</strong> es para ambientes con una personalidad muy marcada. Cada
        preset es solo un punto de partida: después de aplicarlo no queda nada bloqueado.
      </p>
      <PresetGallery client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="comparison">
    <div class="container">
      <h2>Cómo se compara</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Característica</th>
              <th scope="col">Dehancer</th>
              <th scope="col">Film Look Creator</th>
              <th scope="col">GATE.24</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                <td>{row.dehancer}</td>
                <td>{row.flc}</td>
                <td class="highlight">{row.gate24}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p><a href="/es/guias/gate24-vs-dehancer-vs-film-look-creator/">Lee la comparativa completa &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Qué más hace</h2>
      <ul class="feature-list">
        <li>
          <h3>Vista previa de diagnóstico</h3>
          <p>Los modos de superposición de viñeta, grano y detección de piel te enseñan exactamente dónde actúa cada efecto y con qué fuerza. Se acabó ir a ojo.</p>
        </li>
        <li>
          <h3>Calibración de piel en cada plano</h3>
          <p>Toma el tono de piel real de un plano con un selector de color nativo, en vez de fiarte de un único tono fijo.</p>
        </li>
        <li>
          <h3>Acelerado por GPU</h3>
          <p>Funciona con OpenCL: vista previa en tiempo real, sin tener que renderizar para comprobar el resultado.</p>
        </li>
        <li>
          <h3>9 formatos de recorte</h3>
          <p>Desde el 2.39:1 anamórfico del cine hasta el 9:16 vertical para redes.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="playground">
    <div class="container">
      <h2>Prueba los 13 tú mismo</h2>
      <p>
        Elige una foto, elige un preset y míralo en directo. Esto funciona con CSS en tu navegador y
        es solo una <strong>aproximación</strong> de los valores reales de cada preset: sirve para
        hacerte una idea del rango, pero no es el motor de color de GATE.24 (eso es cálculo de
        píxeles en C++/OpenCL y solo corre dentro de Resolve). Para ver el resultado real, mira los
        ejemplos de antes y después y el panel de más arriba.
      </p>
      <LivePresetPlayground client:visible lang="es" />
    </div>
  </section>

  <section class="section" id="requirements">
    <div class="container">
      <h2>Requisitos</h2>
      <dl class="requirements">
        <div>
          <dt>DaVinci Resolve</dt>
          <dd>Vale la versión gratuita; no hace falta la licencia Studio.</dd>
        </div>
        <div>
          <dt>Sistema operativo</dt>
          <dd>Solo Windows por ahora. Mac no está descartado, pero de momento no hay hardware para probarlo.</dd>
        </div>
        <div>
          <dt>Idioma</dt>
          <dd>El panel del plugin está en inglés. El instalador funciona en inglés o en español.</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-5);
    text-align: center;
  }

  .hero-inner {
    max-width: 40rem;
    margin-inline: auto;
  }

  .hero-mark {
    margin-inline: auto;
    margin-bottom: var(--space-2);
  }

  /* .eyebrow (global.css) has no margin-inline: auto, since it stays
     left-aligned everywhere else it's used (home, about, guides). Inside
     this centered hero it needs its own centering or it hugs the left edge
     of its max-width: 60ch box instead of the hero's true center. */
  .hero .eyebrow {
    margin-inline: auto;
  }

  .lede {
    font-size: 1.1rem;
    margin-inline: auto;
  }

  .cta-row {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .fine-print {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin-top: var(--space-2);
  }

  .screencast {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--color-border);
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-3);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  thead th {
    color: var(--color-fg-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  tbody th {
    font-weight: 600;
    color: var(--color-fg);
  }

  td.highlight {
    color: var(--color-fg);
    font-weight: 600;
  }

  .feature-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .feature-list h3 {
    font-size: 1.1rem;
  }

  .requirements {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .requirements dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .requirements dd {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 48rem;
  }
</style>
