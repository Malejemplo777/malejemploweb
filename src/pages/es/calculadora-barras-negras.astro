---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilmPerforations from '../../components/FilmPerforations.astro';
import LetterboxCalculator from '../../components/LetterboxCalculator.tsx';
import { calcBars, ratios } from '../../lib/letterbox';
import { pagePath } from '../../i18n';

const hd = { w: 1920, h: 1080 };
const uhd = { w: 3840, h: 2160 };

const rows = ratios.map((r) => ({
  label: r.label,
  hd: calcBars(hd.w, hd.h, r.value),
  uhd: calcBars(uhd.w, uhd.h, r.value),
}));

const kind = (m: string) => (m === 'letterbox' ? 'Arriba y abajo' : m === 'pillarbox' ? 'A los lados' : 'Ninguna');
const px = (n: number) => n.toLocaleString('es-ES');

const faq = [
  {
    q: '¿Cuánto miden las barras para 2.39:1 en 1920×1080?',
    a: '138 px arriba y 138 px abajo. La imagen que queda es de unos 1920×804.',
  },
  {
    q: '¿Letterbox o pillarbox?',
    a: 'Letterbox son barras arriba y abajo, para una relación más ancha que tu fotograma (2.39:1 sobre 16:9). Pillarbox son barras a los lados, para una más estrecha (1:1 o 4:5 sobre 16:9).',
  },
  {
    q: '¿Por qué la relación resultante no es exactamente 2.39?',
    a: 'Las barras son píxeles enteros e iguales por los dos lados, así que el alto se redondea. No se nota.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Calculadora de barras negras',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Cualquiera (funciona en el navegador)',
    inLanguage: 'es',
    description:
      'Calculadora gratuita que te da el tamaño exacto en píxeles de las barras negras (letterbox o pillarbox) para cualquier resolución y relación de aspecto.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Calculadora de barras negras: tamaño en píxeles"
  description="Calculadora gratuita de letterbox y pillarbox. Elige tu resolución y una relación de aspecto (2.39:1, 2.35:1, 1.85:1, 1:1, 4:5, 9:16) y obtén el tamaño exacto de las barras negras en píxeles."
  alternatePath="/letterbox-calculator/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="hero section">
    <FilmPerforations />
    <div class="container hero-inner">
      <p class="eyebrow">Herramienta gratuita &middot; por Malejemplo</p>
      <h1>Calculadora de barras negras</h1>
      <p class="lede">Elige un tamaño y una relación. Te doy las barras en píxeles.</p>
    </div>
  </section>

  <section class="calc-section">
    <div class="container">
      <LetterboxCalculator client:load lang="es" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>La fórmula</h2>
      <p class="formula">alto visible = ancho ÷ relación<br />barra = (alto − alto visible) ÷ 2</p>
      <p>1920×1080 a 2.39:1: 1920 ÷ 2.39 ≈ 803, así que (1080 − 803) ÷ 2 ≈ <strong>138 px</strong> por barra.</p>
    </div>
  </section>

  <section class="section table-section">
    <div class="container">
      <h2>Las relaciones más habituales, ya calculadas</h2>
      <p>Barra por lado, en píxeles, sobre un fotograma 16:9.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Relación</th>
              <th scope="col">Barras</th>
              <th scope="col">1920×1080</th>
              <th scope="col">3840×2160</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{kind(r.hd.mode)}</td>
                <td>{px(r.hd.bar)} px <span class="dim">→ {r.hd.visibleW}×{r.hd.visibleH}</span></td>
                <td>{px(r.uhd.bar)} px <span class="dim">→ {r.uhd.visibleW}×{r.uhd.visibleH}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>En DaVinci Resolve</h2>
      <ol class="steps">
        <li><strong>Timeline › Output Blanking.</strong> Elige una relación de la lista.</li>
        <li><strong>Inspector › Cropping.</strong> Escribe el tamaño de barra en Crop Top y Crop Bottom (Left y Right si es pillarbox).</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Preguntas</h2>
      <dl class="faq">
        {faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section cta">
    <div class="container narrow">
      <h2>Sin hacer cuentas</h2>
      <p>GATE.24 pone las barras por ti: 6 formatos de recorte del 2.39:1 al 1:1, dentro de DaVinci Resolve.</p>
      <p><a class="btn btn-primary" href={pagePath('gate24', 'es')}>Ver GATE.24</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
    text-align: center;
  }
  .hero-inner {
    max-width: 44rem;
    margin-inline: auto;
  }
  .hero .eyebrow {
    margin-inline: auto;
  }
  .lede {
    font-size: 1.1rem;
    margin-inline: auto;
  }
  .calc-section {
    padding-bottom: var(--space-5);
  }
  .narrow {
    max-width: 44rem;
  }
  .formula {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace;
    color: var(--color-fg);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    padding: 1rem 1.25rem;
    line-height: 1.8;
    max-width: none;
  }
  .table-wrap {
    overflow-x: auto;
    margin-top: var(--space-3);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 36rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  thead th {
    color: var(--color-fg-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  tbody th {
    font-weight: 600;
  }
  .dim {
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    margin-left: 0.25rem;
  }
  .steps {
    color: var(--color-fg-muted);
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }
  .steps strong {
    color: var(--color-fg);
  }
  .faq {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
  }
  .faq dt {
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }
  .faq dd {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .cta {
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .cta .narrow p {
    margin-inline: auto;
  }
</style>
