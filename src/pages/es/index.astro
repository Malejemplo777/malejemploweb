---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import ProductSplit from '../../components/ProductSplit.astro';
import GuideCards from '../../components/GuideCards.astro';
import gate24Wordmark from '../../assets/brand/gate24-wordmark.png';
import { products } from '../../data/products';
import { pagePath } from '../../i18n';
import { getCollection } from 'astro:content';

const wordmarks: Record<string, ImageMetadata> = {
  gate24: gate24Wordmark,
};

const splitProducts = products.map((product) => ({
  ...product,
  wordmark: wordmarks[product.slug],
}));

const guides = (await getCollection('guidesEs'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((entry) => ({
    href: `/es/guias/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.description,
    cover: entry.data.cover,
  }));
---

<BaseLayout
  title="Malejemplo"
  description="Herramientas de cine para DaVinci Resolve, hechas por Malejemplo. GATE.24 ya está disponible."
  alternatePath="/"
>
  <HomeHero lang="es" />

  <section class="section products">
    <div class="container">
      <h2>Productos</h2>
      <ProductSplit products={splitProducts} lang="es" />
    </div>
  </section>

  <section class="section guides">
    <div class="container">
      <div class="row">
        <h2>Guías</h2>
        <a class="all" href={pagePath('guides', 'es')}>Todas las guías &rarr;</a>
      </div>
      <GuideCards entries={guides} lang="es" />
    </div>
  </section>
</BaseLayout>

<style>
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .row h2 {
    margin: 0;
  }

  .all {
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
</style>
